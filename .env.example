# 리워드 쇼핑몰 V2 환경 변수 예시
# 실제 값, 비밀번호, API 키를 이 파일에 입력하거나 커밋하지 마세요.

# 관리자 식별
V2_SUPER_ADMIN_EMAIL=
POINT_MALL_ADMIN_EMAIL=

# 유튜브 재방송 AI 분석(선택)
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=
AI_CONFIG_ENCRYPTION_KEY=
PERSONAL_DATA_ENCRYPTION_KEY=

# 카탈로그 생성 도구(선택)
CATALOG_MIN_IMAGE_SIDE=
CATALOG_MIN_IMAGES=
CATALOG_MIN_IMAGE_DOMAINS=
CATALOG_CONCURRENCY=
CATALOG_LIMIT=
CATALOG_RETRY=
CATALOG_ONLY=

# DB와 파일 저장소는 일반 환경 변수가 아니라 Sites/Cloudflare 바인딩입니다.
# .openai/hosting.json의 논리 이름:
# DB     -> Cloudflare D1
# BUCKET -> Cloudflare R2
# IMAGES -> Cloudflare Images(사용 가능한 호스팅 환경에서 선택)
